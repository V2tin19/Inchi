# ===================================================================
# 理序 (Cairn) — 环境变量配置模板
# 复制此文件为 .env：cp .env.example .env (Windows: copy .env.example .env)
# ===================================================================

# ----------------- 1. 服务端配置 -----------------
PORT=8792
ADMIN_TOKEN=cairn-token

# ----------------- 2. AI 大模型 API 配置 -----------------
# 理序采用标准 OpenAI 兼容协议（/chat/completions），支持几乎所有国内外大模型。
# 注：未配置 LLM 时，理序会自动启用内置的「纯规则引擎」，基本的查记排期与撤销仍可离线可用。
#
# ★ 不想动配置文件？网页右上角「设置 → 自定义 AI 接口」里可以直接填 Base URL / API Key / 模型，
#   支持一键获取模型列表与连接测试，保存后即时生效（优先级高于这里的 .env）。

# 【推荐方案 A：DeepSeek 官方（极高性价比、结构化 JSON 输出稳定）】
# 申请地址：https://platform.deepseek.com
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MODEL_STRONG=deepseek-chat

# 【方案 B：硅基流动 SiliconFlow（国内极速、支持 DeepSeek-V3 / Qwen 等）】
# 申请地址：https://cloud.siliconflow.cn
# LLM_API_KEY=sk-your-siliconflow-api-key
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V3
# LLM_MODEL_STRONG=deepseek-ai/DeepSeek-V3

# 【方案 C：OpenAI 官方】
# LLM_API_KEY=sk-your-openai-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL_STRONG=gpt-4o

# 【方案 D：OpenRouter / OneAPI / 自建中转代理】
# LLM_API_KEY=sk-or-v1-xxx
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-chat
